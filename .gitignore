# =========================================================
# BANGKOK: LAST SURVIVOR - Unity 6 .gitignore
# Keep: Assets/ (including all .meta), Packages/, ProjectSettings/, CLAUDE.md
# =========================================================

# --- Unity generated folders (root only) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Build output ---
/[Bb]uild/
/[Bb]uilds/
/[Bb]uild[s]-*/

# --- Android build artifacts ---
*.apk
*.aab
*.obb
*.apks
/.gradle/
*.keystore.bak

# --- Other build / export artifacts ---
*.unitypackage
*.app
crashlytics-build.properties
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# --- Autogenerated IDE project files (Unity regenerates these) ---
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Debug symbol .meta files (generated)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- IDE folders ---
.vs/
.idea/
.vscode/
*.code-workspace
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- Unity misc ---
sysinfo.txt
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.utmp/

# --- Editor / OS temp files ---
*.swp
*~
*.bak
*.orig
*.blend1
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Explicitly keep (safety net) ---
# Note: .meta files are never ignored by any rule above (except generated
# *.pdb/*.mdb/*.pidb .meta), so no "!*.meta" is needed - adding it here
# would wrongly re-include those debug-symbol .meta files.
!/Assets/
!/Packages/
!/ProjectSettings/
!/CLAUDE.md
